# Keep the attributes file itself stable on every platform.
/.gitattributes text eol=lf

# Render manifests are hash-bound evidence; preserve their exact bytes.
provenance/*_RENDER_MANIFEST.csv -text

# Frozen upstream members are authority bytes; never normalize any member.
/source/upstream/** -text

# Downloaded terminology witnesses are hash-bound evidence, including HTML,
# extracted text, raster renders, and the source PDF.
/qa/terminology_evidence/** -text

# Hash-bound generated and derivative text must remain LF on every platform.
/backend/*.jsonl text eol=lf
/backend/*.json text eol=lf
/backend/*.csv text eol=lf
/backend/*.py text eol=lf
/source/id-ID/*.tex text eol=lf
/source/id-ID/*.bib text eol=lf
/qa/*.py text eol=lf
/qa/*.md text eol=lf
/qa/*.json text eol=lf
/qa/*.ps1 text eol=lf
/qa/ch*_translation_part*.tex text eol=lf
/qa/ch*_translation_parts/*.tex text eol=lf
/provenance/*.md text eol=lf
/provenance/*.json text eol=lf
/README.md text eol=lf
/BUILD.md text eol=lf

# Chapter 11 ledgers/reconciliation are already bound by exact CRLF hashes in
# the admission receipt and backend; these last-match exceptions preserve the
# admitted bytes on every platform.
/provenance/SOURCE_CORRECTIONS_CH11.json -text
/qa/CH11_BACKEND_RECONCILIATION.md -text

# Chapter 13 correction ledger is likewise admitted with its exact CRLF bytes.
/provenance/SOURCE_CORRECTIONS_CH13.json -text

# Chapter 14 correction ledger is likewise admitted with its exact CRLF bytes.
/provenance/SOURCE_CORRECTIONS_CH14.json -text

# The Chapter 14 fixed-build result is bound with its exact PowerShell CRLF bytes.
/qa/CH14_FINAL_BUILD_RESULT.json -text

# The Chapter 15 fixed-build result is bound with its exact PowerShell CRLF bytes.
/qa/CH15_FINAL_BUILD_RESULT.json -text
